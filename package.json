{
  "name": "claude-workbench",
  "version": "0.2.0",
  "description": "ClaudeWorkbench - �?claude CLI 为内核的 AI �?/ 自动�?/ 程序�?/ 工业化工作台（Electron 便携单文件）",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder --win portable",
    "test": "vitest run",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-test.ps1",
    "smoke:mock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-mock.ps1",
    "dist:v3": "npm run build && electron-builder --win -c electron-builder.v3.yml",
    "dist:v4": "npm run build && electron-builder --win -c electron-builder.v4.yml",
    "dist:v5": "npm run build && electron-builder --win -c electron-builder.v5.yml",
    "dist:v6": "npm run build && electron-builder --win -c electron-builder.v6.yml",
    "dist:v7": "npm run build && electron-builder --win -c electron-builder.v7.yml",
    "dist:v8": "npm run build && electron-builder --win -c electron-builder.v8.yml",
    "dist:v9": "npm run build && electron-builder --win -c electron-builder.v9.yml",
    "dist:v10": "npm run build && electron-builder --win -c electron-builder.v10.yml",
    "dist:v11": "npm run build && electron-builder --win -c electron-builder.v11.yml",
    "dist:v12": "npm run build && electron-builder --win -c electron-builder.v12.yml",
    "dist:v13": "npm run build && electron-builder --win -c electron-builder.v13.yml",
    "dist:v14": "npm run build && electron-builder --win -c electron-builder.v14.yml",
    "smoke:failover": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-mock.ps1 -Exe node_modules/electron/dist/electron.exe -ExeArgs . -FailoverMode quota402",
    "launch:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-check.ps1",
    "ui:check": "node scripts/ui-check.mjs",
    "ui:e2e": "node scripts/ui-e2e.mjs",
    "ship": "node scripts/ship.mjs",
    "clean:releases": "node scripts/clean-releases.mjs",
    "release:check": "node scripts/check-ship.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:publish:dry": "node scripts/publish-release.mjs --dry"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "cron-parser": "^5.10.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "node-cron": "^4.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
